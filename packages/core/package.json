{
  "name": "pierko",
  "version": "0.0.0",
  "description": "The lightweight Node.js framework that gets out of your way.",
  "license": "MIT",
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@pierko/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "change-case": "^5.4.4",
    "fast-glob": "^3.3.3",
    "graphql": "^17.0.2",
    "graphql-relay": "^0.10.2",
    "graphql-yoga": "^5.21.2",
    "hono": "^4.13.1",
    "tslib": "^2.3.0",
    "type-graphql": "2.0.0-rc.3",
    "typeorm": "^1.1.0"
  },
  "engines": {
    "node": "^20 || ^22"
  }
}
